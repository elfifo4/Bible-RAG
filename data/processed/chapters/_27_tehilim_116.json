      "source_file": "_27_tehilim-116.txt"
    },
    {
      "verse_id": "_27_tehilim_116_016",
      "book": "תהילים",
      "book_en": "Psalms",
      "chapter": 116,
      "verse": 16,
      "ref": "תהילים קטז:טז",
      "ref_en": "Psalms 116:16",
      "text_original": "אָנָּ֣ה יְהֹוָה֮    כִּֽי־אֲנִ֪י עַ֫בְדֶּ֥ךָ\nאֲֽנִי־עַ֭בְדְּךָ בֶּן־אֲמָתֶ֑ךָ    פִּ֝תַּ֗חְתָּ לְמֽוֹסֵרָֽי׃",
      "text_with_niqqud": "אָנָּה יְהֹוָה כִּי אֲנִי עַבְדֶּךָ אֲנִי עַבְדְּךָ בֶּן אֲמָתֶךָ פִּתַּחְתָּ לְמוֹסֵרָי׃",
      "text_plain": "אנה יהוה כי אני עבדך אני עבדך בן אמתך פתחת למוסרי׃",
      "markers": {
        "before": [],
        "after": []
      },
      "source_file": "_27_tehilim-116.txt"
    },
    {
      "verse_id": "_27_tehilim_116_017",
      "book": "תהילים",
      "book_en": "Psalms",
      "chapter": 116,
      "verse": 17,
      "ref": "תהילים קטז:יז",
      "ref_en": "Psalms 116:17",
      "text_original": "לְֽךָ־אֶ֭זְבַּח זֶ֣בַח תּוֹדָ֑ה    וּבְשֵׁ֖ם יְהֹוָ֣ה אֶקְרָֽא׃",
      "text_with_niqqud": "לְךָ אֶזְבַּח זֶבַח תּוֹדָה וּבְשֵׁם יְהֹוָה אֶקְרָא׃",
      "text_plain": "לך אזבח זבח תודה ובשם יהוה אקרא׃",
      "markers": {
