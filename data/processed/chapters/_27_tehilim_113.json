      "chapter": 113,
      "verse": 1,
      "ref": "תהילים קיג:א",
      "ref_en": "Psalms 113:1",
      "text_original": "הַ֥לְלוּ יָ֨הּ ׀\nהַֽ֭לְלוּ עַבְדֵ֣י יְהֹוָ֑ה    הַֽ֝לְל֗וּ אֶת־שֵׁ֥ם יְהֹוָֽה׃",
      "text_with_niqqud": "הַלְלוּ יָהּ הַלְלוּ עַבְדֵי יְהֹוָה הַלְלוּ אֶת שֵׁם יְהֹוָה",
      "text_plain": "הללו יה הללו עבדי יהוה הללו את שם יהוה",
      "markers": {
        "before": [],
        "after": []
      },
      "source_file": "_27_tehilim-113.txt"
    },
    {
      "verse_id": "_27_tehilim_113_002",
      "book": "תהילים",
      "book_en": "Psalms",
      "chapter": 113,
      "verse": 2,
      "ref": "תהילים קיג:ב",
      "ref_en": "Psalms 113:2",
      "text_original": "יְהִ֤י שֵׁ֣ם יְהֹוָ֣ה מְבֹרָ֑ךְ    מֵֽ֝עַתָּ֗ה וְעַד־עוֹלָֽם׃",
      "text_with_niqqud": "יְהִי שֵׁם יְהֹוָה מְבֹרָךְ מֵעַתָּה וְעַד עוֹלָם",
      "text_plain": "יהי שם יהוה מברך מעתה ועד עולם",
      "markers": {
        "before": [],
        "after": []
      },
      "source_file": "_27_tehilim-113.txt"
    },
    {
      "verse_id": "_27_tehilim_113_003",
      "book": "תהילים",
